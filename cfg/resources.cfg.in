# General: mintamodellek / anyagok (`assoc` demó). Ha nincs teljes Samples/Media, ez fallback az OGRE SDK Media-ra.
[General]
FileSystem=@OGRE_GENERAL_MEDIA@/models
FileSystem=@OGRE_GENERAL_MEDIA@/materials/scripts
FileSystem=@OGRE_GENERAL_MEDIA@/materials/textures

# OgreBites::TrayManager / sdk_* textúrák, profiler (assoc font + meadow nem használja külön, de betöltődik)
[Essential]
Zip=@OGRE_MEDIA_DIR@/packs/SdkTrays.zip
Zip=@OGRE_MEDIA_DIR@/packs/profiler.zip
